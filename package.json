{
  "name": "municipios-br",
  "version": "2.1.0",
  "description": "Brazilian municipality database with flags, CEPs, geolocation, DDD — TypeScript API",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./ceps": {
      "types": "./lib/ceps/index.d.ts",
      "import": "./lib/ceps/index.js",
      "require": "./lib/ceps/index.js"
    },
    "./ceps/sqlite": {
      "types": "./lib/ceps/sqlite.d.ts",
      "import": "./lib/ceps/sqlite.js",
      "require": "./lib/ceps/sqlite.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "lib/",
    "database/municipios-br.sqlite"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "brazil",
    "brasil",
    "bandeiras",
    "flags",
    "municipios",
    "municipalities",
    "icons",
    "svg",
    "png",
    "ibge",
    "cep",
    "postal-code",
    "enderecos",
    "addresses"
  ],
  "author": "Natalia Mesquita",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nataliasm23/icones-bandeiras-br-uf.git"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
